ghost fn to_writer_Name (pm: perm) (x: t_Name_kept) (v: asn1_t k_Name)
requires arel true d_Name pm x v
ensures arel false d_Name pm x v ** Trade.trade (arel false d_Name pm x v) (arel true d_Name pm x v)
{
  ASN1.Pulse.RelKeep.to_writer d_Name pm x v
}

ghost fn to_writer_TBSCertificate (pm: perm) (x: t_TBSCertificate_kept) (v: asn1_t k_TBSCertificate)
requires arel true d_TBSCertificate pm x v
ensures arel false d_TBSCertificate pm x v ** Trade.trade (arel false d_TBSCertificate pm x v) (arel true d_TBSCertificate pm x v)
{
  ASN1.Pulse.RelKeep.to_writer d_TBSCertificate pm x v
}

